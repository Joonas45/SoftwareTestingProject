{
  "name": "softwaretestingproject",
  "version": "1.0.0",
  "description": "[![Coverage Status](https://coveralls.io/repos/github/Joonas45/SoftwareTestingProject/badge.svg?branch=main)](https://coveralls.io/github/Joonas45/SoftwareTestingProject?branch=main)",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "mocha \"test/**/*.test.js\" --reporter mochawesome --reporter-options reportDir=mochawesome-report,reportFilename=report,quiet=true",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=html --report-dir=coverage npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joonas45/SoftwareTestingProject.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/Joonas45/SoftwareTestingProject/issues"
  },
  "homepage": "https://github.com/Joonas45/SoftwareTestingProject#readme",
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "mochawesome": "^8.1.1"
  }
}
